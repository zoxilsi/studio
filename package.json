{
  "name": "jlk-wallpaper-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A touch-first wallpaper studio with mesh gradients and editable shapes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JK-levi/wallpaper-studio.git"
  },
  "bugs": {
    "url": "https://github.com/JK-levi/wallpaper-studio/issues"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "test": "playwright test",
    "test:production": "NEXT_PUBLIC_BASE_PATH=/wallpaper-studio pnpm build && playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.42.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
